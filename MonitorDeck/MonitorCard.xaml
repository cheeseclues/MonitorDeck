<UserControl x:Class="MonitorDeck.MonitorCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="380">
    <UserControl.Resources>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="27"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="SmallChange" Value="1"/>
            <Setter Property="LargeChange" Value="5"/>
        </Style>
    </UserControl.Resources>
    <Border Background="#161E2C" BorderBrush="#28364B" BorderThickness="1"
            CornerRadius="14" Margin="0,0,0,12" Padding="18">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="NameText" Text="Monitor" Foreground="#F3F6FF"
                               FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ConnectionText" Foreground="#91A0B5"
                               FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Border x:Name="StateBadge" Grid.Column="1" BorderBrush="#44526A"
                        BorderThickness="1" Background="#253142"
                        VerticalAlignment="Top" CornerRadius="9" Padding="10,6" Margin="10,0,0,0">
                    <TextBlock x:Name="StateText" Text="Checking..." Foreground="#C9D5EA" FontSize="11"/>
                </Border>
            </Grid>
            <Grid Margin="0,17,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Grid>
                        <TextBlock Text="Brightness" Foreground="#93C5FD" FontSize="13"/>
                        <TextBlock x:Name="BrightnessValue" Text="—" HorizontalAlignment="Right"
                                   FontSize="13" Foreground="White" FontWeight="SemiBold"/>
                    </Grid>
                    <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" IsEnabled="False"
                            ValueChanged="BrightnessSlider_OnValueChanged"/>
                    <TextBlock x:Name="BrightnessDetail" Text="Checking DDC/CI..."
                               ToolTip="" FontSize="11" Foreground="#8D9CB2" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Grid>
                        <TextBlock Text="Contrast" Foreground="#E1A5FA" FontSize="13"/>
                        <TextBlock x:Name="ContrastValue" Text="—" HorizontalAlignment="Right"
                                   FontSize="13" Foreground="White" FontWeight="SemiBold"/>
                    </Grid>
                    <Slider x:Name="ContrastSlider" Minimum="0" Maximum="100" IsEnabled="False"
                            ValueChanged="ContrastSlider_OnValueChanged"/>
                    <TextBlock x:Name="ContrastDetail" Text="Checking DDC/CI..."
                               ToolTip="" FontSize="11" Foreground="#8D9CB2" TextTrimming="CharacterEllipsis"/>
                    <StackPanel x:Name="GpuContrastPanel" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock Text="GPU contrast (SDR experiment)" Foreground="#7EDAD0"
                                   FontSize="12" FontWeight="SemiBold"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="GpuContrastSlider" Minimum="0" Maximum="100" Value="80"
                                    TickFrequency="5"/>
                            <TextBlock x:Name="GpuContrastValue" Grid.Column="1" Text="80%" MinWidth="39"
                                       Margin="6,0,0,0" VerticalAlignment="Center" Foreground="White"/>
                        </Grid>
                        <WrapPanel Margin="0,6,0,0">
                            <Button x:Name="GpuTestButton" Content="Preview for 10 sec" Click="GpuTestButton_OnClick"
                                    Margin="0,0,6,4" Padding="8,4" FontSize="11"/>
                            <Button x:Name="GpuRestoreButton" Content="Reset now" Click="GpuRestoreButton_OnClick"
                                    Margin="0,0,0,4" Padding="8,4" FontSize="11"/>
                        </WrapPanel>
                        <TextBlock x:Name="GpuContrastDetail" Text="Temporary gamma-ramp approximation, not hardware contrast."
                                   FontSize="11" Foreground="#8D9CB2" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Border Background="#121A26" CornerRadius="9" Margin="0,14,0,0" Padding="12,11">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Software brightness (capture-excluded overlay)" Foreground="#89E6D4"
                                   FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SoftwareBrightnessValue" Text="100%" HorizontalAlignment="Right"
                                   Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                    </Grid>
                    <Slider x:Name="SoftwareBrightnessSlider" Minimum="0" Maximum="100" Value="100"
                            ToolTip="0% = black screen; Ctrl+Alt+Shift+F12 resets all software dimming"
                            Margin="0,7,0,0" IsMoveToPointEnabled="True" TickFrequency="1"
                            ValueChanged="SoftwareBrightnessSlider_OnValueChanged"/>
                    <TextBlock x:Name="SoftwareBrightnessDetail" Text="Off (100%). Does not change the monitor backlight."
                               Foreground="#97A9BD" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
