<Window x:Class="MonitorDeck.QuickPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MonitorDeck quick controls" Icon="/Assets/MonitorDeck.ico"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStyle="None"
        ShowInTaskbar="False" ShowActivated="True" Topmost="True"
        WindowStartupLocation="Manual" AllowsTransparency="True"
        Background="Transparent" FontFamily="Segoe UI" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#D7E6FF"/>
            <Setter Property="Background" Value="#26354B"/>
            <Setter Property="BorderBrush" Value="#354762"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Border Background="#101827" BorderBrush="#35465E" BorderThickness="1"
            CornerRadius="14" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="HeaderGrid" Margin="17,13,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MonitorDeck" FontSize="18" FontWeight="Bold" Foreground="#F6F9FF"/>
                    <TextBlock x:Name="CountText" Text="Detecting monitors..." FontSize="11"
                               Foreground="#92A7C3" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↻" FontSize="16" ToolTip="Rescan monitors" Width="31"
                            Margin="0,0,6,0" Padding="0,4" Click="RescanButton_OnClick"/>
                    <Button Content="×" FontSize="19" ToolTip="Close menu" Width="31"
                            Padding="0,2" Click="CloseButton_OnClick"/>
                </StackPanel>
            </Grid>
            <!-- Windows Night Light is global: these controls are intentionally
                 outside the per-monitor rows, not repeated five times. -->
            <Border x:Name="NightLightCard" Grid.Row="1" Margin="11,0,11,9"
                    Background="#172333" BorderBrush="#2C3F56" BorderThickness="1"
                    CornerRadius="11" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="☾  Windows Night Light" Foreground="#F3F5FF"
                                   FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="NightLightStateText" Text="Reading Windows setting…"
                                   Foreground="#9CB0C9" Margin="0,3,0,0" FontSize="10"/>
                    </StackPanel>
                    <CheckBox x:Name="NightLightSwitch" Grid.Column="1"
                              VerticalAlignment="Center" Margin="12,0,0,0"
                              ToolTip="Toggle Windows Night Light globally (experimental)"
                              IsEnabled="False"
                              Checked="NightLightSwitch_OnChanged"
                              Unchecked="NightLightSwitch_OnChanged">
                        <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                                <Border x:Name="Track" Width="44" Height="24"
                                        CornerRadius="12" Background="#334257"
                                        BorderBrush="#566881" BorderThickness="1">
                                    <Ellipse x:Name="Thumb" Width="18" Height="18"
                                             HorizontalAlignment="Left" Margin="3,0,0,0"
                                             Fill="#CFD9EA"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Track" Property="Background" Value="#D68C32"/>
                                        <Setter TargetName="Track" Property="BorderBrush" Value="#EEAB55"/>
                                        <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                        <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Track" Property="Opacity" Value="0.55"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </CheckBox.Template>
                    </CheckBox>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Night Light strength" FontSize="11" Foreground="#E9B975"/>
                            <TextBlock x:Name="NightLightStrengthValue" Grid.Column="1" Text="—"
                                       FontSize="11" Foreground="#F5D4A5"/>
                        </Grid>
                        <Slider x:Name="NightLightStrengthSlider" Minimum="0" Maximum="100"
                                TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                IsEnabled="False"
                                Margin="0,3,0,0" ToolTip="0 = neutral, 100 = warmest; live preview while dragging"
                                ValueChanged="NightLightStrength_OnValueChanged"
                                PreviewMouseLeftButtonUp="NightLightStrength_OnCommit"
                                KeyUp="NightLightStrength_OnKeyUp"/>
                        <TextBlock x:Name="NightLightStrengthNote" FontSize="10"
                                   Foreground="#90A3BD" Text="Reading strength…" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal"
                                Margin="0,9,0,0" VerticalAlignment="Center">
                        <Button x:Name="NightLightRefreshButton" Content="Apply now ↻"
                                ToolTip="Optional: asks Windows to reapply Night Light by briefly switching it OFF and back ON. May visibly flash. Never used automatically while dragging."
                                FontSize="10" Padding="8,4" Margin="0,0,10,0"
                                Click="NightLightForceRefresh_OnClick"/>
                        <Button HorizontalAlignment="Left" Padding="0" Background="Transparent"
                                BorderThickness="0" Foreground="#AFC8F2" FontSize="10"
                                Content="Windows Night Light settings ↗"
                                ToolTip="Opens the official Windows Night Light settings"
                                Click="NightLightSettings_OnClick"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Use the full available height. On exceptionally short desktops, the
                 mouse wheel still works but no permanent scrollbar is displayed. -->
            <ScrollViewer x:Name="MonitorScroll" Grid.Row="2"
                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="MonitorRows" Margin="11,0,11,0"/>
            </ScrollViewer>
            <Border x:Name="FooterBorder" Grid.Row="3" Background="#151F2E" CornerRadius="0,0,14,14"
                    BorderBrush="#2A3A50" BorderThickness="0,1,0,0" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Clear dimming" FontSize="11" Padding="9,6"
                                ToolTip="Set all software dimming to 100% and restore AOC (100/50), Neo G8 (100/75), ASUS VX (100/65). Emergency Ctrl+Alt+Shift+F12 clears overlays only."
                                Click="ClearDimmingButton_OnClick"/>
                        <TextBlock x:Name="StatusText" Text="Ready" FontSize="10"
                                   Foreground="#8CA0BB" Margin="9,0,0,0"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Full view ↗" FontSize="11" Padding="9,6"
                            Click="FullViewButton_OnClick"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
