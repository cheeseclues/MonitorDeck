<Window x:Class="MonitorDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MonitorDeck" Icon="/Assets/MonitorDeck.ico" Width="650" Height="740" Opacity="0" ShowInTaskbar="False" ShowActivated="False" MinWidth="485" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="#0C121D" Foreground="White"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E7F0FF"/>
            <Setter Property="Background" Value="#263750"/>
            <Setter Property="BorderBrush" Value="#435A7D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#131C2A" BorderBrush="#25344A" BorderThickness="0,0,0,1" Padding="24,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MonitorDeck" FontSize="26" FontWeight="Bold" Foreground="#F7F9FF"/>
                    <TextBlock x:Name="Subtitle" Text="Finding connected displays..." Margin="0,5,0,0"
                               Foreground="#9CAFCB" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ResetDimmingButton" Content="Clear dimming" Margin="12,0,0,0"
                        Click="ResetDimmingButton_OnClick" ToolTip="Restore saved full-brightness defaults for AOC, Neo G8, ASUS VX, and remove all overlays. Ctrl+Alt+Shift+F12 clears overlays only."/>
                <Button x:Name="RescanButton" Content="⟳  Rescan" Margin="8,0,0,0"
                        VerticalAlignment="Center" Click="RescanButton_OnClick" ToolTip="Recheck all displays and DDC/CI features"/>
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="18,18,18,8">
            <StackPanel x:Name="CardsPanel">
                <TextBlock Text="Reading Windows display configuration..." Foreground="#92A7C0"
                           FontSize="14" HorizontalAlignment="Center" Margin="15,30"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="#131C2A" BorderBrush="#25344A"
                BorderThickness="0,1,0,0" Padding="22,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Waiting for scan..." Foreground="#9BAFC6"
                           FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="Local only  •  v1.0.21" Foreground="#6885A7"
                           FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
